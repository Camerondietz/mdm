# ─────────────────────────────────────────────────────────────────────────────
# MDM environment template. Copy to `.env` and fill in per environment.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# SECURITY: generate a fresh key, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# true on your dev laptop, false on the Raspberry Pi / any real deployment.
DJANGO_DEBUG=false

# Comma-separated hostnames/IPs that may serve this app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. on the Pi: DJANGO_ALLOWED_HOSTS=mdm.local,192.168.1.50

# Comma-separated origins trusted for POST/PUT (needed behind https / a domain).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mdm.example.com

DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# These creds also seed the Postgres container (docker-compose `db` service).
# Locally POSTGRES_HOST=localhost; in Docker the web service overrides it to `db`.
POSTGRES_DB=mdm
POSTGRES_USER=mdm
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Identity ──────────────────────────────────────────────────────────────────
# Public base URL; every entity's JSON-LD @id is minted from this.
MDM_BASE_URI=https://mdm.example.com

# ── API CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Production hardening (set when DEBUG=false behind TLS) ─────────────────────
DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_HSTS_SECONDS=31536000
