# ─────────────────────────────────────────────────────────────────────────────
# MDM environment template. Copy to `.env` and fill in per environment.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# SECURITY: generate a fresh key, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# true on your dev laptop, false on the Raspberry Pi / any real deployment.
DJANGO_DEBUG=false

# Comma-separated hostnames/IPs that may serve this app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# production (served through the Cloudflare Tunnel):
# DJANGO_ALLOWED_HOSTS=mdm.cameron-dietz.com,<pi-lan-ip>

# Comma-separated origins trusted for POST/PUT (required behind https / a domain).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mdm.cameron-dietz.com

DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# These creds also seed the Postgres container (docker-compose `db` service).
# Locally: POSTGRES_HOST=localhost + the host-published port (5433). In Docker the
# web service overrides these to db:5432 (the container-internal address).
POSTGRES_DB=mdm
POSTGRES_USER=mdm
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Identity ──────────────────────────────────────────────────────────────────
# Public base URL; every entity's JSON-LD @id is minted from this.
MDM_BASE_URI=https://mdm.cameron-dietz.com

# ── API CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Cloudflare Tunnel (production; used by the `production` compose profile) ───
# Token for the tunnel whose public hostname mdm.cameron-dietz.com routes to
# http://web:8000. Create it in the Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Production hardening (set when DEBUG=false behind TLS) ─────────────────────
# Leave SSL redirect OFF — Cloudflare terminates TLS and the app sees the
# X-Forwarded-Proto header (already trusted in settings), so a redirect would loop.
DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_HSTS_SECONDS=31536000
